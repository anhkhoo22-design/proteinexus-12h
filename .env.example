# For a cloud deployment, set these in Render's Environment page.
# Never put real credentials in GitHub or browser JavaScript.
NODE_ENV=production
TURSO_DATABASE_URL=libsql://YOUR-DATABASE.turso.io
TURSO_AUTH_TOKEN=YOUR-PRIVATE-TOKEN
TEACHER_ACTIVATION_CODE=YOUR-PRIVATE-TEACHER-CODE
OWNER_ACTIVATION_CODE=YOUR-PRIVATE-OWNER-CODE
